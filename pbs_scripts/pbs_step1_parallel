set -euo pipefail

module use /g/data/xp65/public/modules
module load conda/analysis3-25.10

: "${SCENARIO:?SCENARIO not set}"
: "${GCM:?GCM not set}"
: "${STARTYEAR:?STARTYEAR not set}"
: "${ENDYEAR:?ENDYEAR not set}"

NCPUS="${PBS_NCPUS:-4}"
NWORKERS="${NWORKERS:-$NCPUS}"
FREQ="${FREQ:-1hr}"

BASE_DIR="/home/565/dh4185/mn51-dh4185/repos_collab/nesp_bff"
PY_SCRIPT="${BASE_DIR}/step1_extracting_variables.py"

echo "Running scenario=${SCENARIO}, gcm=${GCM}, period=${STARTYEAR}-${ENDYEAR}, nworkers=${NWORKERS}, ncpus=${NCPUS}"

python3 -u "${PY_SCRIPT}" \
  --rcm BARPA-R \
  --scenario "${SCENARIO}" \
  --gcm "${GCM}" \
  --freq "${FREQ}" \
  --startYear "${STARTYEAR}" \
  --endYear "${ENDYEAR}" \
  --nworkers "${NWORKERS}"
