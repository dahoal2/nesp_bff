   "source": [
    "import xarray as xr\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "var = 'rsdsdir'\n",
    "city = 'Melbourne'\n",
    "\n",
    "# Example input DataArrays (time series for a point)\n",
    "da_obs   = xr.open_dataset(f\"/g/data/eg3/nesp_bff/step1_raw_data_extraction/BARRA-R2/{city}_AUS-11_ERA5_historical_hres_BOM_BARRA-R2_v1_30min_1995-2014.nc\")[var]\n",
    "da_adj_24 = xr.open_dataset(f\"/g/data/eg3/nesp_bff/step2_qdc_scaling/BARPA-R/{city}_AUS-15_ACCESS-ESM1-5_ssp370_r6i1p1f1_BOM_BARPA-R_v1-r1_30min_2041-2060_QDC-24-BARRAR2.nc\")[var]\n",
    "da_adj_48 = xr.open_dataset(f\"/g/data/eg3/nesp_bff/step2_qdc_scaling/BARPA-R/{city}_AUS-15_ACCESS-ESM1-5_ssp370_r6i1p1f1_BOM_BARPA-R_v1-r1_30min_2041-2060_QDC-48-BARRAR2.nc\")[var]\n",
    "\n",
    "# --- 1. Align all datasets on common time axis ---\n",
    "common_time = da_obs.time.to_index().intersection(da_adj_24.time.to_index()).intersection(da_adj_48.time.to_index())\n",
    "da_obs = da_obs.sel(time=common_time)\n",
    "da_adj_24 = da_adj_24.sel(time=common_time)\n",
    "da_adj_48 = da_adj_48.sel(time=common_time)\n",
    "\n",
    "# --- 2. Compute daily means and anomalies ---\n",
    "df = pd.DataFrame({\n",
    "    \"obs\": da_obs.values,\n",
    "    \"qdc_24\": da_adj_24.values,\n",
    "    \"qdc_48\": da_adj_48.values\n",
    "}, index=common_time)\n",
    "\n",
    "df_daily = df.resample(\"D\").mean()\n",
    "df_anom = df_daily - df_daily.mean()\n",
    "\n",
    "# --- 3. Compare basic statistics ---\n",
    "plt.figure(figsize=(12, 4))\n",
    "plt.plot(da_adj_24.time, da_adj_24, label=\"24-slot QDC\", alpha=0.8)\n",
    "plt.plot(da_adj_48.time, da_adj_48, label=\"48-slot QDC\", alpha=0.8)\n",
    "plt.title(\"QDC Comparison: 24 vs 48 slots (Time Series)\")\n",
    "plt.xlabel(\"Time\")\n",
    "plt.ylabel(\"Adjusted Value\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# --- Scatter comparison ---\n",
    "plt.figure(figsize=(6, 6))\n",
    "plt.scatter(da_adj_24, da_adj_48, s=10, alpha=0.5)\n",
    "lims = [\n",
    "    float(min(da_adj_24.min(), da_adj_48.min())),\n",
    "    float(max(da_adj_24.max(), da_adj_48.max()))\n",
    "]\n",
    "plt.plot(lims, lims, 'r--')\n",
    "plt.title(\"Scatter: 24-slot vs 48-slot QDC\")\n",
    "plt.xlabel(\"24-slot\")\n",
    "plt.ylabel(\"48-slot\")\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# --- Histogram comparison with mean and std ---\n",
    "plt.figure(figsize=(10, 5))\n",
    "bins = np.linspace(\n",
    "    min(da_adj_24.min(), da_adj_48.min()),\n",
    "    max(da_adj_24.max(), da_adj_48.max()),\n",
    "    40\n",
    ")\n",
    "\n",
    "plt.hist(da_adj_24, bins=bins, alpha=0.6, label=\"24-slot\", density=True)\n",
    "plt.hist(da_adj_48, bins=bins, alpha=0.6, label=\"48-slot\", density=True)\n",
    "\n",
    "# Calculate mean and std\n",
    "mean_24, std_24 = da_adj_24.mean().item(), da_adj_24.std().item()\n",
    "mean_48, std_48 = da_adj_48.mean().item(), da_adj_48.std().item()\n",
    "\n",
    "# Add vertical lines for mean and ±std\n",
    "plt.axvline(mean_24, color='blue', linestyle='--', label=f\"24-slot mean ({mean_24:.2f})\")\n",
    "plt.axvline(mean_24 - std_24, color='blue', linestyle=':', alpha=0.6)\n",
    "plt.axvline(mean_24 + std_24, color='blue', linestyle=':', alpha=0.6)\n",
    "\n",
    "plt.axvline(mean_48, color='orange', linestyle='--', label=f\"48-slot mean ({mean_48:.2f})\")\n",
    "plt.axvline(mean_48 - std_48, color='orange', linestyle=':', alpha=0.6)\n",
    "plt.axvline(mean_48 + std_48, color='orange', linestyle=':', alpha=0.6)\n",
    "\n",
    "plt.title(\"Histogram Comparison of QDC Adjusted Data (24 vs 48 slots)\")\n",
    "plt.xlabel(\"Adjusted Value\")\n",
    "plt.ylabel(\"Density\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# --- 4. Plot full time series (short sample period for clarity) ---\n",
    "fig, ax = plt.subplots(figsize=(12, 4))\n",
    "subset = df.loc[\"2000-01-01\":\"2000-01-07\"]  # adjust as needed\n",
    "subset.plot(ax=ax)\n",
    "ax.set_title(\"QDC-adjusted vs Observed (sample week)\")\n",
    "ax.set_ylabel(da_obs.name)\n",
    "ax.legend([\"Observed\", \"QDC 24-slot\", \"QDC 48-slot\"])\n",
    "plt.show()\n",
    "\n",
    "# --- 5. Plot diurnal cycles ---\n",
    "df[\"hour\"] = df.index.hour + df.index.minute / 60\n",
    "diurnal = df.groupby(\"hour\").mean()\n",
    "\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.plot(diurnal.index, diurnal[\"obs\"], label=\"Observed\", lw=2)\n",
    "plt.plot(diurnal.index, diurnal[\"qdc_24\"], label=\"QDC 24-slot\", lw=1.5)\n",
    "plt.plot(diurnal.index, diurnal[\"qdc_48\"], label=\"QDC 48-slot\", lw=1.5)\n",
    "plt.title(\"Mean Diurnal Cycle (Half-hourly data)\")\n",
    "plt.xlabel(\"Hour of Day\")\n",
    "plt.ylabel(da_obs.name)\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "# --- 6. Plot difference between QDC 24 and 48 ---\n",
    "diff = df[\"qdc_48\"] - df[\"qdc_24\"]\n",
    "\n",
    "plt.figure(figsize=(8, 3))\n",
    "plt.plot(diff.index, diff, color=\"gray\")\n",
    "plt.title(\"Difference: QDC 48-slot – QDC 24-slot\")\n",
    "plt.ylabel(\"Δ (units)\")\n",
    "plt.show()\n",
    "\n",
    "# --- Difference histogram (48-slot - 24-slot) ---\n",
    "da_diff = da_adj_48 - da_adj_24\n",
    "mean_diff = da_diff.mean().item()\n",
    "std_diff = da_diff.std().item()\n",
    "min_diff = da_diff.min().item()\n",
    "max_diff = da_diff.max().item()\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.hist(da_diff, bins=100, alpha=0.8, color='gray', edgecolor='black', density=True)\n",
    "\n",
    "# Mean and ±1 std dev\n",
    "plt.axvline(mean_diff, color='red', linestyle='--', label=f\"Mean = {mean_diff:.3f}\")\n",
    "plt.axvline(mean_diff - std_diff, color='red', linestyle=':', alpha=0.7, label=f\"±1σ = {std_diff:.3f}\")\n",
    "plt.axvline(mean_diff + std_diff, color='red', linestyle=':', alpha=0.7)\n",
    "\n",
    "# Min and Max\n",
    "plt.axvline(min_diff, color='blue', linestyle='-.', alpha=0.8, label=f\"Min = {min_diff:.3f}\")\n",
    "plt.axvline(max_diff, color='green', linestyle='-.', alpha=0.8, label=f\"Max = {max_diff:.3f}\")\n",
    "\n",
    "plt.title(\"Histogram of Difference: QDC (48-slot − 24-slot)\")\n",
    "plt.xlabel(\"Difference\")\n",
    "plt.ylabel(\"Density\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# --- 7. Seasonal comparison (optional) ---\n",
    "df[\"month\"] = df.index.month\n",
    "monthly_mean = df.groupby(\"month\").mean()\n",
    "\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.plot(monthly_mean.index, monthly_mean[\"obs\"], label=\"Observed\")\n",
    "plt.plot(monthly_mean.index, monthly_mean[\"qdc_24\"], label=\"QDC 24-slot\")\n",
    "plt.plot(monthly_mean.index, monthly_mean[\"qdc_48\"], label=\"QDC 48-slot\")\n",
    "plt.title(\"Monthly Mean Comparison\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.ylabel(da_obs.name)\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
