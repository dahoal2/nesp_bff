   "source": [
    "import xarray as xr\n",
    "import numpy as np\n",
    "from xclim import sdba\n",
    "import os\n",
    "\n",
    "def radiation_0_adjustment(obs_slice, adjusted):\n",
    "    \"\"\"\n",
    "    Basic radiation zero handling for multiplicative QDC:\n",
    "    - If observation is exactly zero, set adjusted to zero.\n",
    "    - Otherwise keep adjusted.\n",
    "    (You can expand this to the more sophisticated logic you used previously.)\n",
    "    \"\"\"\n",
    "    return xr.where(obs_slice == 0, 0, adjusted)\n",
    "\n",
    "def ensure_30min(da):\n",
    "    \"\"\"Raise if time coordinate is not exactly 30 minute aligned.\"\"\"\n",
    "    mins = np.unique(da.time.dt.minute.values)\n",
    "    if not np.all(np.isin(mins, [0, 30])):\n",
    "        raise ValueError(\"Input data must be aligned to 30-minute steps (minutes must be 0 or 30).\")\n",
    "    # Also warn if any minute not exactly 0/30\n",
    "    if not (da.time.dt.minute % 30 == 0).all():\n",
    "        raise ValueError(\"Some timestamps are not multiples of 30 minutes.\")\n",
    "\n",
    "\n",
    "def apply_qdc_30min_netcdf(\n",
    "    obs_path,\n",
    "    hist_path,\n",
    "    fut_path,\n",
    "    var,\n",
    "    out_path=None,\n",
    "    kind=\"+\",\n",
    "    window=1,\n",
    "    nquantiles=100,\n",
    "    group=\"time.month\",\n",
    "    save_every_slot=False,\n",
    "    verbose=True,\n",
    "):\n",
    "    \"\"\"\n",
    "    Apply Quantile Delta Mapping (QDC) at 30-minute resolution using 48 slots/day.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    obs_path, hist_path, fut_path : str\n",
    "        Paths to NetCDF files containing the observed, historical model and future\n",
    "        model time series. Each file must contain a DataArray named `var`.\n",
    "        Time coordinate must be 30-minute aligned.\n",
    "    var : str\n",
    "        Variable name inside the NetCDF files (e.g., 'pr', 'tas', 'rsds', ...).\n",
    "    out_path : str or None\n",
    "        If provided, save the adjusted DataArray to this NetCDF path.\n",
    "    kind : {'+', '*'}\n",
    "        Additive or multiplicative QDC.\n",
    "    window : int\n",
    "        Sliding-window radius in slots (1 => use slot-1, slot, slot+1).\n",
    "    nquantiles : int\n",
    "        Number of quantiles for the estimator.\n",
    "    group : str\n",
    "        Grouping for sdba train (e.g., 'time.month' or None).\n",
    "    save_every_slot : bool\n",
    "        If True and out_path is given, write intermediate slot results (append).\n",
    "    verbose : bool\n",
    "        Print progress messages.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    da_adjusted : xarray.DataArray\n",
    "        The adjusted DataArray, same coords/dims as input obs (time and any spatial dims).\n",
    "    qdc_models : dict\n",
    "        Dict mapping slot -> trained QuantileDeltaMapping object.\n",
    "    adjusted_slices : dict\n",
    "        Dict mapping slot -> DataArray of adjusted values for that slot.\n",
    "    \"\"\"\n",
    "    # --- Open datasets ---\n",
    "    ds_obs = xr.open_dataset(obs_path)\n",
    "    print(ds_obs)\n",
    "    ds_hist = xr.open_dataset(hist_path)\n",
    "    print(ds_hist)\n",
    "    ds_fut = xr.open_dataset(fut_path)\n",
    "    print(ds_fut)\n",
    "\n",
    "    ds_hist[\"lat\"] = ds_obs[\"lat\"]\n",
    "    ds_hist[\"lon\"] = ds_obs[\"lon\"]\n",
    "    ds_fut[\"lat\"] = ds_obs[\"lat\"]\n",
    "    ds_fut[\"lon\"] = ds_obs[\"lon\"]\n",
    "\n",
    "    # --- Keep only common variables across all datasets ---\n",
    "    common_vars = set(ds_obs.data_vars) & set(ds_hist.data_vars) & set(ds_fut.data_vars)\n",
    "    ds_obs  = ds_obs[list(common_vars)]\n",
    "    ds_hist = ds_hist[list(common_vars)]\n",
    "    ds_fut  = ds_fut[list(common_vars)]\n",
    "\n",
    "    if var not in common_vars:\n",
    "        raise ValueError(f\"Variable '{var}' not found in all datasets. Common vars: {common_vars}\")\n",
    "\n",
    "    da_obs = ds_obs[var]\n",
    "    da_hist = ds_hist[var]\n",
    "    da_fut = ds_fut[var]\n",
    "\n",
    "    # --- Align historical and future datasets ---\n",
    "    if not da_hist.time.equals(da_fut.time):\n",
    "        da_fut = da_fut.reindex(time=da_hist.time, method='nearest')\n",
    "\n",
    "    # --- Align observations to historical (optional) ---\n",
    "    if not da_obs.time.equals(da_hist.time):\n",
    "        da_obs = da_obs.reindex(time=da_hist.time, method='nearest')\n",
    "\n",
    "\n",
    "    # --- Basic checks ---\n",
    "    ensure_30min(da_obs)\n",
    "    ensure_30min(da_hist)\n",
    "    ensure_30min(da_fut)\n",
    "\n",
    "    # Ensure same time alignment (simple check)\n",
    "    if not np.array_equal(da_obs.time.values, da_hist.time.values) and verbose:\n",
    "        print(\"Warning: obs and hist have different time coordinates. Filtering each slot independently.\")\n",
    "    if not np.array_equal(da_obs.time.values, da_fut.time.values) and verbose:\n",
    "        print(\"Warning: obs and fut have different time coordinates. Filtering each slot independently.\")\n",
    "\n",
    "    # slot index 0..47\n",
    "    slot_index_obs = da_obs.time.dt.hour * 2 + da_obs.time.dt.minute // 30\n",
    "    # For hist/fut we will compute slot index on the fly if needed\n",
    "    # Prepare outputs\n",
    "    adjusted_chunks = []\n",
    "    adjusted_slices = {}\n",
    "    qdc_models = {}\n",
    "\n",
    "    nslots = 48\n",
    "    all_slots = list(range(nslots))\n",
    "\n",
    "    for slot in all_slots:\n",
    "        if verbose:\n",
    "            print(f\"Processing slot {slot+1}/{nslots} (slot index={slot})\")\n",
    "\n",
    "        # which slots to include in training (sliding window)\n",
    "        slots_to_use = [(slot + offset) % nslots for offset in range(-window, window + 1)]\n",
    "\n",
    "        # select slices by slot\n",
    "        obs_slice = da_obs.where(slot_index_obs.isin(slots_to_use), drop=True)\n",
    "        # For hist & fut compute slot index relative to their time coords\n",
    "        slot_index_hist = da_hist.time.dt.hour * 2 + da_hist.time.dt.minute // 30\n",
    "        slot_index_fut = da_fut.time.dt.hour * 2 + da_fut.time.dt.minute // 30\n",
    "        hist_slice = da_hist.where(slot_index_hist.isin(slots_to_use), drop=True)\n",
    "        fut_slice = da_fut.where(slot_index_fut.isin(slots_to_use), drop=True)\n",
    "\n",
    "        # If any of the slices are empty, skip or warn\n",
    "        if obs_slice.sizes['time'] == 0 or hist_slice.sizes['time'] == 0 or fut_slice.sizes['time'] == 0:\n",
    "            if verbose:\n",
    "                print(f\"  -> Warning: empty slice for slot {slot}. Skipping.\")\n",
    "            adjusted_slices[slot] = xr.DataArray(\n",
    "                np.full_like(obs_slice, np.nan), coords=obs_slice.coords, dims=obs_slice.dims\n",
    "            )\n",
    "            qdc_models[slot] = None\n",
    "            continue\n",
    "\n",
    "        # Train QDC: note xclim.sdba expects (reference, simulation?) pattern:\n",
    "        # Using same approach as your previous code: train on (fut, hist)\n",
    "        QDC = sdba.QuantileDeltaMapping.train(\n",
    "            fut_slice,\n",
    "            hist_slice,\n",
    "            nquantiles=nquantiles,\n",
    "            group=group,\n",
    "            kind=kind,\n",
    "        )\n",
    "        qdc_models[slot] = QDC\n",
    "\n",
    "        # Adjust observed slice\n",
    "        adjusted = QDC.adjust(obs_slice, interp=\"linear\")\n",
    "\n",
    "        # Radiation handling for multiplicative corrections (basic)\n",
    "        if kind == \"*\" and var in [\"rsds\", \"rsdsdir\"]:\n",
    "            adjusted = radiation_0_adjustment(obs_slice, adjusted)\n",
    "\n",
    "        # Clip bounded variables\n",
    "        if var in [\"hurs\", \"clt\"]:\n",
    "            adjusted = adjusted.clip(min=0, max=100)\n",
    "\n",
    "        # Extract only exact slot timestamps (hour & minute)\n",
    "        target_hour = slot // 2\n",
    "        target_minute = (slot % 2) * 30\n",
    "        mask = (adjusted.time.dt.hour == target_hour) & (adjusted.time.dt.minute == target_minute)\n",
    "        adjusted_slot = adjusted.where(mask, drop=True)\n",
    "\n",
    "        # For multiplicative, fix NaN/inf by using reference obs values for that slot\n",
    "        if kind == \"*\":\n",
    "            ref = obs_slice.where(mask, drop=True)\n",
    "            invalid_mask = xr.where(xr.ufuncs.isnan(adjusted_slot) | np.isinf(adjusted_slot), True, False)\n",
    "            # replace invalid entries with ref (preserving shape)\n",
    "            adjusted_slot = xr.where(invalid_mask, ref, adjusted_slot)\n",
    "\n",
    "        adjusted_slices[slot] = adjusted_slot\n",
    "        adjusted_chunks.append(adjusted_slot)\n",
    "\n",
    "        # Optional: save intermediate results (append) - naive implementation\n",
    "        if save_every_slot and out_path is not None:\n",
    "            # append on first slot, then incrementally\n",
    "            mode = \"w\" if not os.path.exists(out_path) else \"a\"\n",
    "            # create Dataset and to_netcdf (note: append mode with xarray may not concatenate straightforwardly)\n",
    "            ds_tmp = adjusted_slot.to_dataset(name=f\"{var}\")\n",
    "            ds_tmp.to_netcdf(out_path, mode=mode)\n",
    "\n",
    "    # Concatenate adjusted chunks along time (keeps original time order)\n",
    "    if len(adjusted_chunks) == 0:\n",
    "        raise RuntimeError(\"No valid adjusted chunks produced - check your inputs.\")\n",
    "\n",
    "    da_adjusted = xr.concat(adjusted_chunks, dim='time', compat='override').sortby('time')\n",
    "\n",
    "    # Optionally save final result\n",
    "    if out_path is not None and not save_every_slot:\n",
    "        da_adjusted.to_dataset(name=var).to_netcdf(out_path)\n",
    "\n",
    "    return da_adjusted, qdc_models, adjusted_slices\n"
   ]
  },
