   "source": [
    "import xarray as xr\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "vars_list = ['tas','hurs','huss','sfcWind','psl','uas','vas','clt','rsds','rsdsdir']#,'pr']\n",
    "var = 'rsdsdir'\n",
    "city = 'Melbourne'\n",
    "\n",
    "for var in vars_list:\n",
    "    # ===============================================================\n",
    "    # 1. INPUTS\n",
    "    # ===============================================================\n",
    "    da_obs   = xr.open_dataset(f\"/g/data/eg3/nesp_bff/step1_raw_data_extraction/BARRA-R2/{city}_AUS-11_ERA5_historical_hres_BOM_BARRA-R2_v1_30min_1995-2014.nc\")[var]\n",
    "    da_adj_24 = xr.open_dataset(f\"/g/data/eg3/nesp_bff/step2_qdc_scaling/BARPA-R/{city}_AUS-15_ACCESS-ESM1-5_ssp370_r6i1p1f1_BOM_BARPA-R_v1-r1_30min_2041-2060_QDC-24-BARRAR2.nc\")[var]\n",
    "    da_adj_48 = xr.open_dataset(f\"/g/data/eg3/nesp_bff/step2_qdc_scaling/BARPA-R/{city}_AUS-15_ACCESS-ESM1-5_ssp370_r6i1p1f1_BOM_BARPA-R_v1-r1_30min_2041-2060_QDC-48-BARRAR2.nc\")[var]\n",
    "    \n",
    "    \n",
    "    # --- 1. Align all datasets on common time axis ---\n",
    "    common_time = da_obs.time.to_index().intersection(da_adj_24.time.to_index()).intersection(da_adj_48.time.to_index())\n",
    "    da_obs = da_obs.sel(time=common_time)\n",
    "    da_adj_24 = da_adj_24.sel(time=common_time)\n",
    "    da_adj_48 = da_adj_48.sel(time=common_time)\n",
    "    \n",
    "    # ===============================================================\n",
    "    # 2. HELPER FUNCTIONS\n",
    "    # ===============================================================\n",
    "    \n",
    "    def rmse(a, b):\n",
    "        return np.sqrt(((a - b) ** 2).mean())\n",
    "    \n",
    "    def mae(a, b):\n",
    "        return np.abs(a - b).mean()\n",
    "    \n",
    "    def tail_abs_error(a, b, q):\n",
    "        \"\"\"Absolute error at a given quantile level (e.g., 0.95 or 0.99).\"\"\"\n",
    "        a_q = np.nanquantile(a, q)\n",
    "        b_q = np.nanquantile(b, q)\n",
    "        return abs(a_q - b_q)\n",
    "    \n",
    "    # ===============================================================\n",
    "    # 3. GLOBAL METRICS\n",
    "    # ===============================================================\n",
    "    \n",
    "    rmse_24 = rmse(da_adj_24, da_obs)\n",
    "    rmse_48 = rmse(da_adj_48, da_obs)\n",
    "    mae_24 = mae(da_adj_24, da_obs)\n",
    "    mae_48 = mae(da_adj_48, da_obs)\n",
    "    \n",
    "    # ===============================================================\n",
    "    # 4. DIURNAL SKILL ANALYSIS\n",
    "    # ===============================================================\n",
    "    \n",
    "    # Slot index (0–47 for half-hourly)\n",
    "    slot_index = da_obs.time.dt.hour * 2 + da_obs.time.dt.minute // 30\n",
    "    \n",
    "    slot_means_obs = da_obs.groupby(slot_index).mean()\n",
    "    slot_means_24  = da_adj_24.groupby(slot_index).mean()\n",
    "    slot_means_48  = da_adj_48.groupby(slot_index).mean()\n",
    "    \n",
    "    # Mean absolute change in diurnal pattern (QDC vs obs)\n",
    "    diurnal_diff_24 = np.abs(slot_means_24 - slot_means_obs).mean()\n",
    "    diurnal_diff_48 = np.abs(slot_means_48 - slot_means_obs).mean()\n",
    "    \n",
    "    # Tail quantile absolute error averaged across slots\n",
    "    def per_slot_tail_error(da_qdc, da_obs, quantile):\n",
    "        errs = []\n",
    "        for s in range(48):\n",
    "            obs_s = da_obs.where(slot_index == s, drop=True)\n",
    "            qdc_s = da_qdc.where(slot_index == s, drop=True)\n",
    "            if len(obs_s.time) > 10:\n",
    "                errs.append(tail_abs_error(qdc_s, obs_s, quantile))\n",
    "        return np.mean(errs)\n",
    "    \n",
    "    tail05_24 = per_slot_tail_error(da_adj_24, da_obs, 0.05)\n",
    "    tail01_24 = per_slot_tail_error(da_adj_24, da_obs, 0.01)\n",
    "    tail05_48 = per_slot_tail_error(da_adj_48, da_obs, 0.05)\n",
    "    tail01_48 = per_slot_tail_error(da_adj_48, da_obs, 0.01)\n",
    "    tail95_24 = per_slot_tail_error(da_adj_24, da_obs, 0.95)\n",
    "    tail99_24 = per_slot_tail_error(da_adj_24, da_obs, 0.99)\n",
    "    tail95_48 = per_slot_tail_error(da_adj_48, da_obs, 0.95)\n",
    "    tail99_48 = per_slot_tail_error(da_adj_48, da_obs, 0.99)\n",
    "    \n",
    "    # ===============================================================\n",
    "    # 5. SLOT-WISE IMPROVEMENT FRACTION\n",
    "    # ===============================================================\n",
    "    \n",
    "    rmse_slot_24, rmse_slot_48 = [], []\n",
    "    for s in range(48):\n",
    "        obs_s = da_obs.where(slot_index == s, drop=True)\n",
    "        q24_s = da_adj_24.where(slot_index == s, drop=True)\n",
    "        q48_s = da_adj_48.where(slot_index == s, drop=True)\n",
    "        if len(obs_s.time) > 10:\n",
    "            rmse_slot_24.append(rmse(q24_s, obs_s))\n",
    "            rmse_slot_48.append(rmse(q48_s, obs_s))\n",
    "    \n",
    "    rmse_slot_24 = np.array(rmse_slot_24)\n",
    "    rmse_slot_48 = np.array(rmse_slot_48)\n",
    "    \n",
    "    frac_improve = np.mean(rmse_slot_48 < rmse_slot_24)\n",
    "    \n",
    "    # ===============================================================\n",
    "    # 6. SUMMARY TABLE\n",
    "    # ===============================================================\n",
    "    \n",
    "    summary = pd.DataFrame({\n",
    "        \"Metric\": [\n",
    "            \"Global RMSE\", \n",
    "            \"Global MAE\", \n",
    "            \"Mean |Δ Diurnal Pattern|\", \n",
    "            \"Tail Abs Error (1st)\", \n",
    "            \"Tail Abs Error (5th)\",\n",
    "            \"Tail Abs Error (95th)\", \n",
    "            \"Tail Abs Error (99th)\", \n",
    "            \"Fraction of Slots where Q48 improves RMSE\"\n",
    "        ],\n",
    "        \"QDC_24\": [\n",
    "            float(rmse_24), float(mae_24), float(diurnal_diff_24), tail01_24, tail05_24, tail95_24, tail99_24, np.nan\n",
    "        ],\n",
    "        \"QDC_48\": [\n",
    "            float(rmse_48), float(mae_48), float(diurnal_diff_48), tail01_48, tail05_48, tail95_48, tail99_48, frac_improve\n",
    "        ]\n",
    "    })\n",
    "    \n",
    "    print(f\"\\n===== QDC PERFORMANCE SUMMARY FOR {var} in {city} =====\")\n",
    "    print(summary.to_string(index=False, float_format=lambda x: f\"{x:.4f}\"))\n",
    "    \n",
    "    # ===============================================================\n",
    "    # 7. VISUALISATION\n",
    "    # ===============================================================\n",
    "    \n",
    "    fig, axs = plt.subplots(2, 2, figsize=(12, 8))\n",
    "    fig.suptitle(f\"QDC Skill Evaluation: 24-slot vs 48-slot for {var} ({city})\", fontsize=14)\n",
    "    \n",
    "    # (a) Diurnal mean patterns\n",
    "    axs[0,0].plot(slot_means_obs, 'k-', label='Observed', linewidth=2)\n",
    "    axs[0,0].plot(slot_means_24, 'b--', label='QDC 24-slot')\n",
    "    axs[0,0].plot(slot_means_48, 'r--', label='QDC 48-slot')\n",
    "    axs[0,0].set_title(\"Mean Diurnal Pattern\")\n",
    "    axs[0,0].set_xlabel(\"Slot (0–47 = half-hour bins)\")\n",
    "    axs[0,0].set_ylabel(\"Value\")\n",
    "    axs[0,0].legend()\n",
    "    axs[0,0].grid(True)\n",
    "    \n",
    "    # (b) RMSE per slot\n",
    "    axs[0,1].plot(rmse_slot_24, 'b-', label='QDC 24-slot')\n",
    "    axs[0,1].plot(rmse_slot_48, 'r-', label='QDC 48-slot')\n",
    "    axs[0,1].set_title(\"RMSE by Half-hour Slot\")\n",
    "    axs[0,1].set_xlabel(\"Slot\")\n",
    "    axs[0,1].set_ylabel(\"RMSE\")\n",
    "    axs[0,1].legend()\n",
    "    axs[0,1].grid(True)\n",
    "    \n",
    "    # (c) Histogram of RMSE differences (48 - 24)\n",
    "    axs[1,0].hist(rmse_slot_48 - rmse_slot_24, bins=20, color='gray', edgecolor='black')\n",
    "    axs[1,0].axvline(0, color='red', linestyle='--')\n",
    "    axs[1,0].set_title(\"Distribution of RMSE Improvement (48 - 24)\")\n",
    "    axs[1,0].set_xlabel(\"ΔRMSE (negative = improvement)\")\n",
    "    axs[1,0].set_ylabel(\"Frequency\")\n",
    "    axs[1,0].grid(True)\n",
    "    \n",
    "    # (d) Global metrics comparison bar chart\n",
    "    metrics = [\"RMSE\", \"MAE\", \"|Δ Diurnal|\", \"Tail01\", \"Tail05\", \"Tail95\", \"Tail99\"]\n",
    "    vals_24 = [rmse_24, mae_24, diurnal_diff_24, tail01_24, tail05_24, tail95_24, tail99_24]\n",
    "    vals_48 = [rmse_48, mae_48, diurnal_diff_48, tail01_48, tail05_48, tail95_48, tail99_48]\n",
    "    \n",
    "    x = np.arange(len(metrics))\n",
    "    width = 0.35\n",
    "    axs[1,1].bar(x - width/2, vals_24, width, label='24-slot')\n",
    "    axs[1,1].bar(x + width/2, vals_48, width, label='48-slot')\n",
    "    axs[1,1].set_xticks(x)\n",
    "    axs[1,1].set_xticklabels(metrics)\n",
    "    axs[1,1].set_title(\"Aggregate Skill Metrics\")\n",
    "    axs[1,1].legend()\n",
    "    axs[1,1].grid(True, axis='y')\n",
    "    \n",
    "    plt.tight_layout(rect=[0, 0, 1, 0.96])\n",
    "    plt.show()\n"
   ]
  },
